  "title": "Gradebook: Cost per Correct Decision",
  "variables": {},
  "version": "v5",
  "widgets": [
    {
      "contextLinks": {
        "linksData": null
      },
      "description": "Headline metric (ADR 0001, definition fixed in C9/#54): (sum(augmentloop.cost.usd) / count(correct decisions)) * 1000, scoped to augmentloop.grade.source = 'math'. The numerator A is ALL math cost - money spent on WRONG answers included - so this is what we spent per answer we got right, not the flattering cost-of-only-correct-answers version. Denominator B is correct math decisions. Scoping to math (a decision emits at most one math grade) structurally removes the earlier double-count that reality grades caused, so this reconciles to the cent with the CLI's total_cost / correct on the same run. Reality grades are NOT blended into this number - they have their own adjacent panels (reality correct rate & count). AI-judge grades are never in the headline (ADR 0001). SCOPING: augmentloop.decision.type is limited to the four model-decision types (route_choice from the toy world, filler_detection/quote_extraction/clip_scoring from the CleanCut substrate), deliberately excluding build_session, the #13 meta build-fleet unit - a whole agent session, not a single graded model decision - which skewed this headline 534x on 2026-07-25.",
      "id": "panel-1-headline-cost-per-correct",
      "legendPosition": "bottom",
      "nullZeroValues": "zero",
      "opacity": "1",
      "panelTypes": "value",
      "query": {
        "builder": {
          "queryData": [
            {
              "aggregations": [
                {
                  "metricName": "gradebook.decision.cost.usd.sum",
                  "spaceAggregation": "sum",
                  "timeAggregation": "latest"
                }
              ],
              "dataSource": "metrics",
              "disabled": true,
              "expression": "A",
              "filter": {
                "expression": "augmentloop.grade.source = 'math' AND augmentloop.decision.type IN ('route_choice','filler_detection','quote_extraction','clip_scoring')"
              },
              "functions": [],
              "groupBy": [],
              "having": [],
              "legend": "Total cost (all math decisions)",
              "limit": 100,
              "orderBy": [
                {
                  "columnName": "__result",
                  "order": "desc"
                }
              ],
              "queryName": "A",
              "stepInterval": null
            },
            {
              "aggregations": [
                {
                  "metricName": "gradebook.decisions.graded",
                  "spaceAggregation": "sum",
                  "timeAggregation": "latest"
                }
              ],
              "dataSource": "metrics",
              "disabled": true,
              "expression": "B",
              "filter": {
                "expression": "gen_ai.evaluation.score.label = 'correct' AND augmentloop.grade.source = 'math' AND augmentloop.decision.type IN ('route_choice','filler_detection','quote_extraction','clip_scoring')"
              },
              "functions": [],
              "groupBy": [],
              "having": [],
              "legend": "Correct decisions (math)",
              "limit": 100,
              "orderBy": [
                {
                  "columnName": "__result",
                  "order": "desc"
                }
              ],
              "queryName": "B",
              "stepInterval": null
            }
          ],
          "queryFormulas": [
            {
              "disabled": false,
              "expression": "(A/B)*1000",
              "legend": "Cost per 1,000 Correct Decisions",
              "queryName": "F1"
            }
          ]
        },
        "id": "panel-1-headline-cost-per-correct-query",
        "queryType": "builder"
      },
      "selectedLogFields": [
        {
          "fieldContext": "log",
          "name": "timestamp",
          "signal": "logs",
          "type": "log"
        },
        {
          "fieldContext": "log",
          "name": "body",
          "signal": "logs",
          "type": "log"
        }
      ],
      "selectedTracesFields": [
        {
          "fieldContext": "resource",
          "fieldDataType": "string",
          "name": "service.name",
          "signal": "traces"
        },
        {
          "fieldContext": "span",
          "fieldDataType": "string",
          "name": "name",
          "signal": "traces"
        }
      ],
      "softMax": 0,
      "softMin": 0,
      "timePreferance": "GLOBAL_TIME",
      "title": "Cost per 1,000 Correct Decisions",
      "yAxisUnit": "none"
    },
