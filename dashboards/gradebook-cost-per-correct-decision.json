  "title": "Gradebook: Cost per Correct Decision",
  "variables": {},
  "version": "v5",
  "widgets": [
    {
      "contextLinks": {
        "linksData": null
      },
      "description": "Headline metric (ADR 0001): sum(augmentloop.cost.usd) / count(decisions) where gen_ai.evaluation.score.label='correct' AND augmentloop.grade.source in (math, reality). AI-judge grades are never mixed into this number.",
      "id": "panel-1-headline-cost-per-correct",
      "legendPosition": "bottom",
      "nullZeroValues": "zero",
      "opacity": "1",
      "panelTypes": "value",
      "query": {
        "builder": {
          "queryData": [
            {
              "aggregations": [
                {
                  "metricName": "gradebook.decision.cost.usd.sum",
                  "spaceAggregation": "sum",
                  "timeAggregation": "latest"
                }
              ],
              "dataSource": "metrics",
              "disabled": true,
              "expression": "A",
              "filter": {
                "expression": "gen_ai.evaluation.score.label = 'correct' AND augmentloop.grade.source IN ('math','reality')"
              },
              "functions": [],
              "groupBy": [],
              "having": [],
              "legend": "Total cost (correct, math+reality)",
              "limit": 100,
              "orderBy": [
                {
                  "columnName": "__result",
                  "order": "desc"
                }
              ],
              "queryName": "A",
              "stepInterval": null
            },
            {
              "aggregations": [
                {
                  "metricName": "gradebook.decisions.graded",
                  "spaceAggregation": "sum",
                  "timeAggregation": "latest"
                }
              ],
              "dataSource": "metrics",
              "disabled": true,
              "expression": "B",
              "filter": {
                "expression": "gen_ai.evaluation.score.label = 'correct' AND augmentloop.grade.source IN ('math','reality')"
              },
              "functions": [],
              "groupBy": [],
              "having": [],
              "legend": "Correct decisions (math+reality)",
              "limit": 100,
              "orderBy": [
                {
                  "columnName": "__result",
                  "order": "desc"
                }
              ],
              "queryName": "B",
              "stepInterval": null
            }
          ],
          "queryFormulas": [
            {
              "disabled": false,
              "expression": "A/B",
              "legend": "Cost per Correct Decision",
              "queryName": "F1"
            }
          ]
        },
        "id": "panel-1-headline-cost-per-correct-query",
        "queryType": "builder"
      },
      "selectedLogFields": [
        {
          "fieldContext": "log",
          "name": "timestamp",
          "signal": "logs",
          "type": "log"
        },
        {
          "fieldContext": "log",
          "name": "body",
          "signal": "logs",
          "type": "log"
        }
      ],
      "selectedTracesFields": [
        {
          "fieldContext": "resource",
